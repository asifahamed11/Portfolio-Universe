rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Aggregate statistics are public to read, but only trusted Admin SDK
    // processes may write them. A client-writable map with dynamic URL keys
    // cannot be type-checked safely in Firestore Rules.
    match /global_stats/likes {
      allow read: if true;
      allow write: if false;
    }

    match /global_stats/{statDoc} {
      allow read, write: if false;
    }

    // Portfolio metadata is maintained by the trusted migration job. Public
    // clients may only increment an existing view counter by exactly one;
    // creates, arbitrary values, and metadata changes are rejected.
    match /portfolios/{portfolioKey} {
      allow read: if true;

      allow create: if false;

      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
                    && request.resource.data.views is int
                    && request.resource.data.views >= 1
                    && (
                      (
                        !resource.data.keys().hasAny(['views'])
                        && request.resource.data.views == 1
                      )
                      ||
                      (
                        resource.data.views is int
                        && resource.data.views >= 0
                        && request.resource.data.views == resource.data.views + 1
                      )
                    );

      allow delete: if false;
    }

    // Bookmark documents are private and intentionally limited to the one
    // field used by the application.
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(['bookmarks'])
                    && request.resource.data.bookmarks is list
                    && request.resource.data.bookmarks.size() <= 2000;
      allow update: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.data.keys().hasOnly(['bookmarks'])
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bookmarks'])
                    && request.resource.data.bookmarks is list
                    && request.resource.data.bookmarks.size() <= 2000;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Users may create a small, exact-schema review request. Status changes
    // and reads are reserved for the Admin SDK workflow.
    match /submissions/{submissionId} {
      function validPendingSubmission() {
        return request.auth != null
                    && submissionId == request.auth.uid
                    && request.resource.data.keys().hasOnly([
                      'uid',
                      'name',
                      'url',
                      'status',
                      'createdAt'
                    ])
                    && request.resource.data.uid is string
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() >= 1
                    && request.resource.data.name.size() <= 100
                    && request.resource.data.url is string
                    && request.resource.data.url.size() >= 8
                    && request.resource.data.url.size() <= 2048
                    && request.resource.data.url.matches('^https?://[^ <>"]+$')
                    && request.resource.data.status == 'pending'
                    && request.resource.data.createdAt is timestamp
                    && request.resource.data.createdAt == request.time;
      }

      allow create: if validPendingSubmission();
      allow update: if validPendingSubmission()
                    && (
                      resource.data.status in ['rejected', 'duplicate']
                      ||
                      (
                        resource.data.status == 'accepted'
                        && resource.data.processedAt is timestamp
                        && request.time > resource.data.processedAt + duration.value(1, 'd')
                      )
                    );
      allow read, delete: if false;
    }
  }
}
