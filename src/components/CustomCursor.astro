---
// CustomCursor.astro
---

<div id="custom-cursor" class="pointer-events-none fixed inset-0 z-[10000] hidden">

  <svg aria-hidden="true" style="position: absolute; width: 0; height: 0; overflow: hidden;" version="1.1" xmlns="http://www.w3.org/2000/svg">
    <filter id="cursor-glass-filter" x="-50%" y="-50%" width="200%" height="200%" filterUnits="objectBoundingBox">
      <feTurbulence type="fractalNoise" baseFrequency="0.01" numOctaves="1" seed="5" result="turbulence" />
      <feComponentTransfer in="turbulence" result="mapped">
        <feFuncR type="gamma" amplitude="1" exponent="10" offset="0.5" />
        <feFuncG type="gamma" amplitude="0" exponent="1" offset="0" />
        <feFuncB type="gamma" amplitude="0" exponent="1" offset="0.5" />
      </feComponentTransfer>
      <feGaussianBlur in="turbulence" stdDeviation="3" result="softMap" />
      <feSpecularLighting in="softMap" surfaceScale="3" specularConstant="0.4" specularExponent="100" lighting-color="white" result="specLight">
        <fePointLight x="-200" y="-200" z="300" />
      </feSpecularLighting>
      <feComposite in="specLight" operator="arithmetic" k1="0" k2="1" k3="1" k4="0" result="litImage" />
      <feDisplacementMap in="SourceGraphic" in2="softMap" scale="40" xChannelSelector="R" yChannelSelector="G" />
    </filter>
  </svg>

  <!-- Main Container -->
  <div id="cursor-main" class="absolute top-0 left-0 rounded-full flex items-center justify-center will-change-transform transition-[width,height] duration-300 ease-[cubic-bezier(0.16,1,0.3,1)] z-[10000]" style="width: 24px; height: 24px; transform: translate(-50%, -50%);">

    <!-- Dynamic Background Glass Distortion Layer -->
    <div id="cursor-glass-layer" class="absolute inset-0 rounded-full pointer-events-none overflow-hidden transition-[backdrop-filter] duration-300 transform-gpu"
         style="
           -webkit-backdrop-filter: blur(0px);
           backdrop-filter: blur(0px);
           -webkit-filter: url(#cursor-glass-filter);
           filter: url(#cursor-glass-filter);
           will-change: transform, backdrop-filter;
           transform: translateZ(0);
         ">
    </div>

    <!-- Edge Lighting Layer -->
    <div id="cursor-border-layer" class="absolute inset-0 rounded-full pointer-events-none transition-all duration-300"
         style="
           box-shadow: inset 2px 2px 0px -2px rgba(255, 255, 255, 0.3), inset 0 0 3px 1px rgba(255, 255, 255, 0.2);
           border: 1px solid rgba(255,255,255,0.05);
         ">
    </div>
  </div>

  <!-- Clear text wrapper -->
  <div id="cursor-text-wrapper" class="absolute top-0 left-0 flex items-center justify-center will-change-transform pointer-events-none transition-[width,height] duration-300 z-[10001]" style="transform: translate(-50%, -50%); width: 24px; height: 24px;">
    <span id="cursor-text" class="text-white text-[11px] uppercase tracking-[0.2em] font-extrabold opacity-0 transition-opacity duration-300 ml-[2px]" style="text-shadow: 0 2px 10px rgba(0,0,0,1);"></span>
  </div>
</div>

<style is:global>
  @media (pointer: fine) {
    html.custom-cursor-active,
    html.custom-cursor-active * {
      cursor: none !important;
    }

    html.custom-cursor-active input,
    html.custom-cursor-active textarea,
    html.custom-cursor-active select,
    html.custom-cursor-active [contenteditable="true"] {
      cursor: text !important;
    }
  }
</style>

<script>
  const initializeCustomCursor = () => {
    const finePointer = window.matchMedia('(pointer: fine)');
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const cursorContainer = document.getElementById('custom-cursor') as HTMLElement | null;
    const cursorMain = document.getElementById('cursor-main') as HTMLElement | null;
    const cursorTextWrapper = document.getElementById('cursor-text-wrapper') as HTMLElement | null;
    const cursorText = document.getElementById('cursor-text') as HTMLElement | null;
    const borderLayer = document.getElementById('cursor-border-layer') as HTMLElement | null;
    if (!cursorContainer || !cursorMain || !cursorTextWrapper || !cursorText || !borderLayer) return;

    let cursorEnabled = finePointer.matches && !reducedMotion.matches;
    document.documentElement.classList.toggle('custom-cursor-active', cursorEnabled);
    cursorContainer.classList.toggle('hidden', !cursorEnabled);

    let mouseX = window.innerWidth / 2;
    let mouseY = window.innerHeight / 2;
    let cursorX = mouseX;
    let cursorY = mouseY;
    let targetScale = 1;
    let currentScale = 1;
    let frameId = 0;
    let visible = false;
    let currentMode = 'default';

    const scheduleRender = () => {
      if (cursorEnabled && !frameId && visible && !document.hidden) {
        frameId = requestAnimationFrame(render);
      }
    };

    const render = () => {
      frameId = 0;
      cursorX += (mouseX - cursorX) * 0.25;
      cursorY += (mouseY - cursorY) * 0.25;
      currentScale += (targetScale - currentScale) * 0.25;

      const transform = `translate3d(calc(${cursorX}px - 50%), calc(${cursorY}px - 50%), 0) scale(${currentScale})`;
      cursorMain.style.transform = transform;
      cursorTextWrapper.style.transform = transform;

      if (
        Math.abs(mouseX - cursorX) > 0.1
        || Math.abs(mouseY - cursorY) > 0.1
        || Math.abs(targetScale - currentScale) > 0.01
      ) {
        scheduleRender();
      }
    };

    const setVisible = (nextVisible: boolean) => {
      visible = cursorEnabled && nextVisible;
      cursorContainer.classList.toggle('hidden', !visible);
      if (visible) scheduleRender();
      else if (frameId) {
        cancelAnimationFrame(frameId);
        frameId = 0;
      }
    };

    const syncCursorPreference = () => {
      const wasEnabled = cursorEnabled;
      cursorEnabled = finePointer.matches && !reducedMotion.matches;
      document.documentElement.classList.toggle('custom-cursor-active', cursorEnabled);
      if (!cursorEnabled) setVisible(false);
      else if (!wasEnabled) setVisible(true);
    };

    finePointer.addEventListener('change', syncCursorPreference);
    reducedMotion.addEventListener('change', syncCursorPreference);

    const setMode = (mode: 'default' | 'card' | 'control' | 'like') => {
      if (mode === currentMode) return;
      currentMode = mode;
      const size = mode === 'card' ? 80 : mode === 'control' ? 48 : mode === 'like' ? 12 : 24;
      cursorMain.style.width = `${size}px`;
      cursorMain.style.height = `${size}px`;
      cursorTextWrapper.style.width = `${size}px`;
      cursorTextWrapper.style.height = `${size}px`;
      cursorText.textContent = mode === 'card' ? 'OPEN' : '';
      cursorText.style.opacity = mode === 'card' ? '1' : '0';
      borderLayer.style.background = mode === 'control' ? 'rgba(244,63,94,0.02)' : 'transparent';
      borderLayer.style.boxShadow = mode === 'like'
        ? 'inset 2px 2px 0px -2px rgba(244,63,94,.6), inset 0 0 3px 1px rgba(244,63,94,.4)'
        : mode === 'control'
          ? 'inset 2px 2px 0px -2px rgba(244,63,94,.4), inset 0 0 5px 1px rgba(244,63,94,.2)'
          : mode === 'card'
            ? 'inset 2px 2px 0px -2px rgba(255,255,255,.4), inset 0 0 5px 2px rgba(255,255,255,.2)'
            : 'inset 2px 2px 0px -2px rgba(255,255,255,.3), inset 0 0 3px 1px rgba(255,255,255,.2)';
      scheduleRender();
    };

    document.addEventListener('pointermove', (event) => {
      if (!cursorEnabled) return;
      mouseX = event.clientX;
      mouseY = event.clientY;
      setVisible(true);

      const target = event.target instanceof Element ? event.target : null;
      if (target?.closest('input, textarea, select, [contenteditable="true"]')) {
        setVisible(false);
        return;
      }
      if (target?.closest('.bookmark-btn')) setMode('like');
      else if (target?.closest('.portfolio-link')) setMode('card');
      else if (target?.closest('button, a, .filter-btn, .cursor-pointer')) setMode('control');
      else setMode('default');
      scheduleRender();
    }, { passive: true });

    document.addEventListener('pointerdown', () => {
      targetScale = 0.8;
      scheduleRender();
    }, { passive: true });
    document.addEventListener('pointerup', () => {
      targetScale = 1;
      scheduleRender();
    }, { passive: true });
    document.addEventListener('pointerleave', () => setVisible(false));
    window.addEventListener('blur', () => setVisible(false));
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) setVisible(false);
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeCustomCursor, { once: true });
  } else {
    initializeCustomCursor();
  }
</script>
