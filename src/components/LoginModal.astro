---
// LoginModal.astro
---

<div
  id="loginModal"
  class="fixed inset-0 z-50 flex items-start sm:items-center justify-center overflow-y-auto p-4 opacity-0 pointer-events-none transition-opacity duration-300"
  role="dialog"
  aria-modal="true"
  aria-labelledby="loginTitle"
  aria-describedby="loginDescription"
  aria-hidden="true"
  inert
>
  <!-- Backdrop -->
  <div id="loginBackdrop" class="absolute inset-0 bg-gray-950/60 backdrop-blur-md"></div>
  
  <!-- Modal Content -->
  <div class="relative my-auto w-full max-w-md max-h-[calc(100dvh-2rem)] overflow-y-auto bg-gray-900/80 backdrop-blur-xl border border-gray-700/50 rounded-3xl shadow-2xl p-6 sm:p-8 transform scale-95 transition-transform duration-300" id="loginCard" tabindex="-1" data-lenis-prevent>
    <button type="button" id="closeLoginBtn" aria-label="Close sign-in dialog" class="absolute top-4 right-4 text-gray-400 hover:text-white focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 transition-colors p-2 rounded-full hover:bg-gray-800/50">
      <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
    </button>
    
    <div class="text-center mb-8">
      <h2 id="loginTitle" class="text-3xl font-bold text-white mb-2">Welcome Back</h2>
      <p id="loginDescription" class="text-gray-400">Sign in to save your favorite portfolios.</p>
    </div>

    <!-- Login Buttons -->
    <div class="space-y-4">
      <button type="button" id="googleLoginBtn" class="w-full flex items-center justify-center gap-3 bg-white hover:bg-gray-50 text-gray-900 font-semibold py-3 px-4 rounded-xl transition-all shadow-md active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="20px" height="20px"><path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/><path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/><path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/><path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/></svg>
        Continue with Google
      </button>
      
      <button type="button" id="githubLoginBtn" class="w-full flex items-center justify-center gap-3 bg-gray-800 hover:bg-gray-700 text-white font-semibold py-3 px-4 rounded-xl transition-all border border-gray-700 active:scale-[0.98] focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
        Continue with GitHub
      </button>
    </div>

    <div class="mt-8 flex flex-col items-center gap-4">
      <div class="flex items-center justify-center gap-2 text-sm text-gray-400">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        Secure Auth by Google Firebase
      </div>
      
      <p class="text-xs text-gray-400 text-center max-w-[280px] leading-relaxed">
        By continuing, you agree to our 
        <a href={`${import.meta.env.BASE_URL}terms/`} class="text-gray-400 hover:text-white underline underline-offset-2 transition-colors">Terms of Service</a> and 
        <a href={`${import.meta.env.BASE_URL}privacy/`} class="text-gray-400 hover:text-white underline underline-offset-2 transition-colors">Privacy Policy</a>.
      </p>
    </div>
  </div>
</div>

<script>
  import { auth, googleProvider, githubProvider } from '../lib/firebase.js';
  import { signInWithPopup } from 'firebase/auth';

  const loginModal = document.getElementById('loginModal') as HTMLElement | null;
  const loginBackdrop = document.getElementById('loginBackdrop') as HTMLElement | null;
  const loginCard = document.getElementById('loginCard') as HTMLElement | null;
  const closeLoginBtn = document.getElementById('closeLoginBtn') as HTMLButtonElement | null;
  const googleLoginBtn = document.getElementById('googleLoginBtn') as HTMLButtonElement | null;
  const githubLoginBtn = document.getElementById('githubLoginBtn') as HTMLButtonElement | null;
  let previouslyFocused: HTMLElement | null = null;

  const isOpen = () => loginModal?.getAttribute('aria-hidden') === 'false';
  const focusableElements = () => Array.from(
    loginModal?.querySelectorAll<HTMLElement>(
      'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])'
    ) ?? []
  ).filter(element => !element.hasAttribute('inert') && element.offsetParent !== null);

  const releaseBodyLock = () => {
    const anotherDialogIsOpen = document.querySelector('[role="dialog"][aria-hidden="false"]');
    if (!anotherDialogIsOpen) document.body.classList.remove('modal-open');
  };

  // Open Modal function is globally available
  (window as any).openLoginModal = () => {
    if (loginModal && loginCard) {
      previouslyFocused = document.activeElement instanceof HTMLElement ? document.activeElement : null;
      loginModal.inert = false;
      loginModal.setAttribute('aria-hidden', 'false');
      loginModal.classList.remove('opacity-0', 'pointer-events-none');
      loginCard.classList.remove('scale-95');
      loginCard.classList.add('scale-100');
      document.body.classList.add('modal-open');
      requestAnimationFrame(() => googleLoginBtn?.focus());
    }
  };

  document.addEventListener('click', event => {
    const target = event.target;
    if (target instanceof Element && target.closest('[data-login-trigger]')) {
      (window as any).openLoginModal();
    }
  });

  const closeModal = () => {
    if (loginModal && loginCard && isOpen()) {
      loginModal.setAttribute('aria-hidden', 'true');
      loginModal.inert = true;
      loginModal.classList.add('opacity-0', 'pointer-events-none');
      loginCard.classList.remove('scale-100');
      loginCard.classList.add('scale-95');
      releaseBodyLock();
      const fallback = auth.currentUser
        ? document.getElementById('logoutBtn')
        : document.getElementById('loginBtn');
      const focusTarget = previouslyFocused?.isConnected
        && previouslyFocused.offsetParent !== null
        && !previouslyFocused.closest('[inert]')
        ? previouslyFocused
        : fallback;
      if (focusTarget instanceof HTMLElement && focusTarget.offsetParent !== null) {
        focusTarget.focus();
      } else {
        requestAnimationFrame(() => {
          const delayedFallback = auth.currentUser
            ? document.getElementById('logoutBtn')
            : document.getElementById('loginBtn');
          if (
            delayedFallback instanceof HTMLElement
            && delayedFallback.offsetParent !== null
          ) {
            delayedFallback.focus();
          }
        });
      }
      previouslyFocused = null;
    }
  };

  closeLoginBtn?.addEventListener('click', closeModal);
  loginBackdrop?.addEventListener('click', closeModal);
  document.addEventListener('keydown', (event) => {
    if (!isOpen()) return;
    if (event.key === 'Escape') {
      event.preventDefault();
      closeModal();
      return;
    }
    if (event.key !== 'Tab') return;

    const elements = focusableElements();
    if (elements.length === 0) {
      event.preventDefault();
      loginCard?.focus();
      return;
    }

    const first = elements[0];
    const last = elements[elements.length - 1];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  // CODE-1 fix: Extract repeated button HTML into constants
  const GOOGLE_BTN_HTML = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="20px" height="20px"><path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/><path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/><path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/><path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/></svg> Continue with Google`;
  const GITHUB_BTN_HTML = `<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg> Continue with GitHub`;

  const getOriginalBtnHTML = (providerName: 'Google' | 'GitHub') => providerName === 'Google' ? GOOGLE_BTN_HTML : GITHUB_BTN_HTML;

  // Real Firebase Login functionality
  const handleFirebaseLogin = async (providerName: 'Google' | 'GitHub') => {
    const btn = providerName === 'Google' ? googleLoginBtn : githubLoginBtn;
    if (!btn) return;

    try {
      const provider = providerName === 'Google' ? googleProvider : githubProvider;
      
      // Update button state (optional feedback)
      const originalText = btn.innerHTML;
      btn.innerHTML = `<svg class="animate-spin h-5 w-5 mr-3 text-gray-500" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Connecting...`;
      btn.disabled = true;
      
      await signInWithPopup(auth, provider);

      
      // Firebase's onAuthStateChanged in index.astro will handle the UI update globally!
      closeModal();
      
      // Restore button text
      setTimeout(() => {
        btn.innerHTML = originalText;
        btn.disabled = false;
      }, 500);

    } catch (error: any) {
      btn.innerHTML = getOriginalBtnHTML(providerName);
      btn.disabled = false;

      if (error.code === 'auth/popup-closed-by-user' || error.code === 'auth/cancelled-popup-request') {
        return;
      }
      console.error("Login failed:", error);
      alert(`Login failed: ${error.message || 'Please try again.'}`);
    }
  };

  googleLoginBtn?.addEventListener('click', () => handleFirebaseLogin('Google'));
  githubLoginBtn?.addEventListener('click', () => handleFirebaseLogin('GitHub'));
</script>
