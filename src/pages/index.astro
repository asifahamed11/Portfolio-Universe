  }

  /* Hide scrollbar for smooth horizontal scrolling */
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  .filter-rail-shell::after {
    content: '';
    position: absolute;
    top: 2px;
    left: auto;
    right: 2px;
    bottom: 2px;
    width: 2.5rem;
    border-radius: 0 22px 22px 0;
    background: linear-gradient(to right, transparent, rgba(2, 4, 12, 0.94));
