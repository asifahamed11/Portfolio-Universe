---
import PortfolioCard from '../components/PortfolioCard.astro';
import LoginModal from '../components/LoginModal.astro';
import SubmitModal from '../components/SubmitModal.astro';
import CustomCursor from '../components/CustomCursor.astro';
import portfoliosData from '../data/portfolios.json';
import VariableProximityWrapper from '../components/VariableProximityWrapper.jsx';
import Shuffle from '../components/Shuffle.jsx';
import SpecularButton from '../components/SpecularButton.jsx';
import DotField from '../components/DotField.jsx';
import '../styles/global.css';
import { sanitizePortfolio } from '../lib/utils.js';

const portfolios = portfoliosData
  .map((portfolio, index) => sanitizePortfolio({ ...portfolio, baseLikes: 0 }, index))
  .filter((portfolio): portfolio is NonNullable<typeof portfolio> => portfolio !== null);
const canonicalUrl = new URL(import.meta.env.BASE_URL, Astro.site);
---

<html lang="en">
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;700;900&family=Space+Grotesk:wght@400;700;900&display=swap" rel="stylesheet">
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Developer Portfolios Showcase</title>
    <meta name="description" content="A curated directory of developer portfolios inspired by Emma Bostian's repository." />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content="Developer Portfolios Showcase" />
    <meta property="og:description" content="A curated directory of developer portfolios inspired by Emma Bostian's repository." />
    <meta property="og:image" content="https://images.unsplash.com/photo-1517694712202-14dd9538aa97?q=80&w=1200&auto=format&fit=crop" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content="Developer Portfolios Showcase" />
    <meta property="twitter:description" content="A curated directory of developer portfolios inspired by Emma Bostian's repository." />
    <meta property="twitter:image" content="https://images.unsplash.com/photo-1517694712202-14dd9538aa97?q=80&w=1200&auto=format&fit=crop" />

    <!-- Google Analytics -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-N4PMFMQQ6Q"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-N4PMFMQQ6Q');
    </script>
    <!-- U1 fix: removed `.portfolio-wrapper { content-visibility: auto }`.
         Its implicit paint containment clipped the hover summary tooltip (which is
         drawn above the card). Off-screen cards are already virtualized in JS by
         toggling the `hidden` class, so the perf intent is preserved. -->
  </head>
  <body class="bg-[#070b18] text-gray-200 min-h-screen font-sans antialiased selection:bg-rose-500/30">
    <div class="site-background" aria-hidden="true">
      <div class="site-background__ambient"></div>
      <DotField
        client:load
        className="site-background__dots"
        dotRadius={2.1}
        dotSpacing={18}
        cursorRadius={230}
        bulgeStrength={26}
        glowRadius={180}
        bulgeOnly={true}
        sparkle={false}
        waveAmplitude={0}
        gradientFrom="rgba(103, 232, 249, 0.43)"
        gradientTo="rgba(167, 139, 250, 0.35)"
        glowColor="rgba(56, 189, 248, 0.16)"
      />
      <div class="site-background__veil"></div>
    </div>
    <a href="#portfolioMain" class="skip-link">Skip to portfolios</a>
    <style>
      .animate-hero-text {
        opacity: 0;
        animation: heroReveal 0.8s cubic-bezier(0.2, 0, 0, 1) forwards;
      }

      @keyframes heroReveal {
        0% {
          opacity: 0;
          transform: translateY(24px);
        }
        100% {
          opacity: 1;
          transform: translateY(0);
        }
      }

      @keyframes heartBurst {
        0% { transform: scale(1); }
        25% { transform: scale(1.5) rotate(-10deg); filter: brightness(1.5) drop-shadow(0 0 8px rgba(244,63,94,0.6)); }
        50% { transform: scale(0.85) rotate(10deg); }
        75% { transform: scale(1.15) rotate(-5deg); filter: brightness(1.2); }
        100% { transform: scale(1) rotate(0deg); }
      }

      @keyframes heartUnlike {
        0% { transform: scale(1.2); filter: brightness(1.5); }
        40% { transform: scale(0.7) rotate(15deg); opacity: 0.6; }
        70% { transform: scale(1.1) rotate(-5deg); opacity: 0.9; }
        100% { transform: scale(1) rotate(0deg); opacity: 1; }
      }

      .heart-animated {
        animation: heartBurst 0.34s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
      }

      .text-metallic {
        background: linear-gradient(to bottom right, #ffffff 30%, #737373 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }

      .heart-unlike-animated {
        animation: heartUnlike 0.26s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
      }

      /* BUG-2 fix: each card wrapper creates its own stacking context, so a card's
         summary popup could render *under* the card sitting in the row above it.
         Lift the hovered wrapper above its neighbours so the popup (which overflows
         upward) always paints on top of everything else. */
      .portfolio-wrapper {
        position: relative;
        z-index: 1;
      }
      .portfolio-wrapper:hover,
      .portfolio-wrapper:focus-within {
        z-index: 50;
      }
    </style>

    <!-- Navigation Bar -->
    <nav id="topNavBar" class="site-nav sticky top-3 z-40 max-w-7xl mx-4 xl:mx-auto rounded-[24px] border border-white/[0.05]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-14">
          <button type="button" id="scrollToTopBtn" aria-label="Scroll to the top" class="flex items-center gap-2 cursor-pointer rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400">
            <span class="text-white font-extrabold tracking-tight text-lg flex items-center gap-1.5" style="font-family: 'Space Grotesk', sans-serif;">
              Portfolio
              <Shuffle
                client:load
                text="Universe"
                className="text-cyan-400 pb-1"
                shuffleDirection="right"
                duration={0.35}
                stagger={0.03}
                shuffleTimes={1}
                triggerOnHover={true}
              />
            </span>
          </button>
          
          <div class="flex items-center gap-3 md:gap-4">
            <div>
              <SpecularButton
                client:load
                size="sm"
                radius={999}
                tint="#8b5cf6"
                tintOpacity={0.07}
                blur={10}
                textColor="#dbeafe"
                lineColor="#c4b5fd"
                baseColor="#475569"
                intensity={1.1}
                shineSize={12}
                shineFade={34}
                thickness={1}
                proximity={190}
                className="specular-button--nav-quiet"
                data-submit-trigger="true"
                aria-label="Submit a portfolio"
              >
                <svg aria-hidden="true" class="sm:hidden" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M12 5v14M5 12h14"/></svg>
                <span class="hidden sm:inline">Submit</span>
              </SpecularButton>
            </div>
            
            <!-- Auth Section -->
            <div id="authSection" class="flex items-center gap-3">
              <SpecularButton
                client:load
                id="loginBtn"
                size="sm"
                radius={999}
                tint="#2563eb"
                tintOpacity={0.18}
                blur={12}
                textColor="#ffffff"
                lineColor="#e0f2fe"
                baseColor="#2563eb"
                intensity={1.25}
                shineSize={13}
                shineFade={36}
                thickness={1.15}
                proximity={210}
                className="specular-button--nav-primary"
                data-login-trigger="true"
              >
                Login
              </SpecularButton>
              
              <!-- Logged In User View (Hidden by default) -->
              <div id="userProfile" class="hidden items-center gap-2 group">
                <img id="userAvatar" src="" alt="Avatar" referrerpolicy="no-referrer" class="w-8 h-8 rounded-full border border-gray-700 group-hover:border-blue-500 transition-colors" />
                <span id="userName" class="text-sm font-medium text-gray-200 hidden md:block"></span>
                <button type="button" id="logoutBtn" class="text-xs text-gray-400 hover:text-red-400 ml-2 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-400 rounded">Logout</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <header class="pt-10 pb-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto text-center relative z-10 flex flex-col items-center justify-center">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/10 bg-transparent text-[11px] font-semibold text-white/70 uppercase tracking-widest mb-6 animate-hero-text" style="animation-delay: 0.1s; box-shadow: 0 0 20px rgba(255,255,255,0.02);">
        <span class="w-1.5 h-1.5 rounded-full bg-sky-400 shadow-[0_0_10px_rgba(56,189,248,0.8)] animate-pulse"></span>
        Regularly Updated Showcase
      </div>

      <h1 class="text-5xl sm:text-6xl md:text-[5.5rem] font-bold mb-4 leading-[0.95] tracking-tighter flex flex-col items-center justify-center relative z-10 w-full uppercase" style="font-family: 'Space Grotesk', sans-serif;">
        <span class="text-white animate-hero-text drop-shadow-xl" style="animation-delay: 0.2s; letter-spacing: -0.04em;">The Universe</span>
        <span class="text-metallic animate-hero-text" style="animation-delay: 0.3s; letter-spacing: -0.04em;">of Creators</span>
      </h1>

      <div class="mt-5 text-[1rem] md:text-[1.1rem] text-gray-400 max-w-2xl mx-auto leading-relaxed font-normal animate-hero-text text-center" style="font-family: 'Outfit', sans-serif; animation-delay: 0.4s;">
        <VariableProximityWrapper
          client:visible
          count={portfolios.length}
        />
      </div>

      <section class="discovery-dock animate-hero-text" style="animation-delay: 0.4s;" aria-label="Discover portfolios">
        <div class="search-shell discovery-search relative" data-search-shell>
          <label for="searchInput" class="sr-only">Search developer portfolios</label>
          <span class="search-shell__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7.5"/><path d="m20 20-3.8-3.8"/></svg>
          </span>
          <input type="search" id="searchInput" placeholder="Search creator, role, or technology…" class="search-shell__input" autocomplete="off" autocapitalize="none" spellcheck="false" enterkeyhint="search" aria-controls="portfolioGrid" aria-keyshortcuts="/" />
          <span class="search-shell__shortcut" aria-hidden="true">/</span>
          <button type="button" class="search-shell__clear" data-search-clear aria-label="Clear search" aria-hidden="true" tabindex="-1" hidden>
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="m7 7 10 10M17 7 7 17"/></svg>
          </button>
        </div>

        <label class="discovery-select">
          <span class="discovery-control__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 6h16M7 12h10M10 18h4"/></svg>
          </span>
          <span class="discovery-control__copy"><small>Role</small></span>
          <select id="roleFilterSelect" aria-label="Filter by role">
            <option value="all">All roles</option>
            <option value="fullstack">Full Stack</option>
            <option value="frontend">Frontend</option>
            <option value="backend">Backend</option>
            <option value="ai">AI / ML</option>
            <option value="mobile">Mobile</option>
            <option value="devops">DevOps / Cloud</option>
            <option value="designer">Design</option>
            <option value="other">Other roles</option>
          </select>
          <svg class="discovery-select__chevron" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m7 10 5 5 5-5"/></svg>
        </label>

        <button type="button" id="hireFilterBtn" class="discovery-toggle" aria-pressed="false">
          <span class="discovery-toggle__signal" aria-hidden="true"></span>
          <span><small>Availability</small>Open to work</span>
        </button>

        <label class="discovery-select">
          <span class="discovery-control__icon" aria-hidden="true">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18M6 12h12M9 18h6"/></svg>
          </span>
          <span class="discovery-control__copy"><small>Sort</small></span>
          <select id="sortSelect" aria-label="Sort portfolios">
            <option value="curated">Curated</option>
            <option value="score">Top rated</option>
            <option value="likes">Most liked</option>
            <option value="views">Most viewed</option>
          </select>
          <svg class="discovery-select__chevron" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="m7 10 5 5 5-5"/></svg>
        </label>

        <button type="button" id="savedFilterBtn" class="discovery-toggle discovery-toggle--saved" aria-pressed="false">
          <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.1" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
          <span><small>Collection</small>Saved</span>
        </button>
      </section>

      <div class="discovery-meta animate-hero-text" style="animation-delay: 0.46s;">
        <span><strong id="resultCount">{portfolios.length.toLocaleString('en-US')}</strong> portfolios ready to explore</span>
        <button type="button" class="discovery-reset" data-clear-filters hidden>Reset filters</button>
      </div>
    </header>

    <main id="portfolioMain" class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24 z-10" tabindex="-1">
      <p id="resultStatus" class="sr-only" role="status" aria-live="polite" aria-atomic="true">{portfolios.length} portfolios available.</p>
      <div id="portfolioGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 md:gap-8 items-start" aria-busy="false">
        {portfolios.slice(0, 40).map((portfolio, index) => (
          <div 
            class="portfolio-wrapper" 
            data-index={index}
            data-name={portfolio.name.toLowerCase()}
            data-url={portfolio.url}
            data-role={portfolio.role?.toLowerCase() || ''}
            data-tech={Array.isArray(portfolio.tech_stack) ? portfolio.tech_stack.join(',').toLowerCase() : ''}
            data-hire={portfolio.available_for_hire ? 'true' : 'false'}
            data-score={portfolio.portfolioScore || 0}
          >
            <PortfolioCard 
              name={portfolio.name} 
              url={portfolio.url} 
              screenshot={portfolio.screenshot} 
              summary={portfolio.summary}
              role={portfolio.role}
              tech_stack={portfolio.tech_stack}
              available_for_hire={portfolio.available_for_hire}
              base_likes={portfolio.baseLikes}
              views={portfolio.views || 0}
            />
          </div>
        ))}
      </div>

      <template id="portfolioCardTemplate">
        <div class="portfolio-wrapper">
          <PortfolioCard
            name="Portfolio"
            url="https://example.com"
            screenshot="https://images.unsplash.com/photo-1517694712202-14dd9538aa97?q=80&w=600&auto=format&fit=crop"
            summary="Portfolio summary"
            role="Developer"
            tech_stack={['Stack one', 'Stack two', 'Stack three', 'Stack four']}
            available_for_hire={true}
            base_likes={0}
            views={0}
          />
        </div>
      </template>
      
      <!-- Empty State -->
      <div id="emptyState" class="hidden text-center py-20">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-800/50 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-500"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-2">No portfolios found</h3>
        <p class="text-gray-400 text-lg">Try adjusting your search or filters.</p>
        <button type="button" class="mt-4 rounded font-medium text-blue-400 hover:text-blue-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400" data-clear-filters>Clear all filters</button>
      </div>

      <!-- Infinite Scroll Trigger / Loader -->
      <button type="button" id="loadMoreContainer" aria-label="Load more portfolios" class="mt-16 mb-8 w-full justify-center items-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 rounded-full" style="display: none;">
        <span class="flex items-center gap-3 px-6 py-3 bg-gray-900/50 backdrop-blur-md rounded-full border border-gray-800">
          <svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-blue-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
          </svg>
          <span class="text-sm font-medium text-gray-400">Loading more portfolios...</span>
        </span>
      </button>
    </main>

    <footer class="border-t border-gray-800/50 bg-gray-950/50 backdrop-blur-sm py-12 text-center text-gray-400">
      <p class="mb-4">
        Built with <a href="https://astro.build" class="text-gray-400 hover:text-white transition-colors">Astro</a>.
      </p>
      <div class="flex justify-center gap-6 text-sm">
        <a href={`${import.meta.env.BASE_URL}privacy/`} class="text-gray-400 underline decoration-gray-600 underline-offset-4 hover:text-gray-200 transition-colors">Privacy Policy</a>
        <a href={`${import.meta.env.BASE_URL}terms/`} class="text-gray-400 underline decoration-gray-600 underline-offset-4 hover:text-gray-200 transition-colors">Terms of Service</a>
      </div>
    </footer>

    <div id="toast-container" class="fixed bottom-6 right-6 z-[1000] flex flex-col gap-3 pointer-events-none"></div>

    <CustomCursor />
    <LoginModal />
    <SubmitModal />

<style>
  .search-shell {
    isolation: isolate;
    height: 2.5rem;
    border-radius: 999px;
    background:
      linear-gradient(135deg, rgba(10, 18, 36, 0.86), rgba(5, 9, 22, 0.8));
    -webkit-backdrop-filter: blur(14px) saturate(135%);
    backdrop-filter: blur(14px) saturate(135%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 8px 26px rgba(0, 0, 0, 0.2);
    transition:
      transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 220ms ease,
      background-color 220ms ease;
  }

  .search-shell::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    padding: 1px;
    border-radius: inherit;
    background: linear-gradient(
      110deg,
      rgba(100, 116, 139, 0.45),
      rgba(103, 232, 249, 0.7),
      rgba(129, 140, 248, 0.62),
      rgba(100, 116, 139, 0.4)
    );
    background-size: 220% 100%;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0.5;
    pointer-events: none;
    transition: opacity 200ms ease;
  }

  .search-shell::after {
    content: '';
    position: absolute;
    inset: -5px;
    z-index: -1;
    border-radius: inherit;
    background: linear-gradient(90deg, rgba(34, 211, 238, 0.15), rgba(139, 92, 246, 0.15));
    filter: blur(12px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms ease;
  }

  .search-shell:focus-within {
    transform: translateY(-1px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.11),
      0 10px 30px rgba(2, 132, 199, 0.12),
      0 0 0 3px rgba(34, 211, 238, 0.07);
  }

  .search-shell:focus-within::before {
    opacity: 1;
    animation: searchRimSweep 2.8s linear infinite;
  }

  .search-shell:focus-within::after {
    opacity: 1;
  }

  .search-shell__input {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: inherit;
    outline: none;
    background: transparent;
    padding: 0 3rem 0 2.65rem;
    color: #e5f2ff;
    caret-color: #67e8f9;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.005em;
  }

  .search-shell__input::placeholder {
    color: rgba(148, 163, 184, 0.72);
    transition: color 180ms ease;
  }

  .search-shell:focus-within .search-shell__input::placeholder {
    color: rgba(186, 230, 253, 0.6);
  }

  .search-shell__input::-webkit-search-cancel-button {
    display: none;
  }

  .search-shell__icon {
    position: absolute;
    top: 50%;
    left: 0.85rem;
    z-index: 2;
    display: grid;
    place-items: center;
    color: rgba(148, 163, 184, 0.78);
    pointer-events: none;
    transform: translateY(-50%);
    transform-origin: center;
    transition:
      color 180ms ease,
      transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 180ms ease;
  }

  .search-shell:focus-within .search-shell__icon {
    color: #67e8f9;
    filter: drop-shadow(0 0 7px rgba(34, 211, 238, 0.55));
    transform: translateY(-50%) scale(1.08) rotate(-5deg);
  }

  .search-shell[data-searching="true"] .search-shell__icon {
    animation: searchIconPulse 700ms ease-in-out infinite alternate;
  }

  .search-shell__shortcut {
    position: absolute;
    top: 50%;
    right: 0.75rem;
    z-index: 2;
    min-width: 1.35rem;
    padding: 0.1rem 0.35rem;
    border: 1px solid rgba(148, 163, 184, 0.16);
    border-radius: 0.4rem;
    background: rgba(255, 255, 255, 0.035);
    color: rgba(148, 163, 184, 0.68);
    font-size: 0.68rem;
    line-height: 1.1rem;
    text-align: center;
    pointer-events: none;
    transform: translateY(-50%);
    transition:
      opacity 150ms ease,
      transform 180ms ease;
  }

  .search-shell[data-has-value="true"] .search-shell__shortcut,
  .search-shell:focus-within .search-shell__shortcut {
    opacity: 0;
    transform: translateY(-50%) scale(0.8);
  }

  .search-shell__clear {
    position: absolute;
    top: 50%;
    right: 0.35rem;
    z-index: 3;
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid rgba(148, 163, 184, 0.13);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.045);
    color: rgba(203, 213, 225, 0.8);
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      color 160ms ease,
      background-color 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .search-shell__clear[hidden] {
    display: none;
  }

  .search-shell__clear:hover {
    border-color: rgba(103, 232, 249, 0.32);
    background: rgba(34, 211, 238, 0.1);
    color: #cffafe;
    transform: translateY(-50%) scale(1.05);
  }

  .search-shell__clear:focus-visible {
    outline: 2px solid rgba(103, 232, 249, 0.85);
    outline-offset: 2px;
  }

  @keyframes searchRimSweep {
    to {
      background-position: -220% 0;
    }
  }

  @keyframes searchIconPulse {
    to {
      color: #c4b5fd;
      filter: drop-shadow(0 0 9px rgba(139, 92, 246, 0.6));
    }
  }

  #topNavBar::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      border-radius: 24px;
      background-color: rgba(255, 255, 255, 0.01);
      pointer-events: none;
  }
  
  #topNavBar::after {
      content: '';
      position: absolute;
      z-index: -2;
      inset: 0;
      border-radius: 24px;
      -webkit-backdrop-filter: blur(8px) saturate(120%);
              backdrop-filter: blur(8px) saturate(120%);
      overflow: hidden;
      isolation: isolate;
      pointer-events: none;
  }


  .site-nav {
    isolation: isolate;
    transition:
      transform 260ms cubic-bezier(0.16, 1, 0.3, 1),
      opacity 220ms ease;
    will-change: transform;
  }

  .discovery-dock {
    position: relative;
    isolation: isolate;
    display: grid;
    width: 100%;
    max-width: 76rem;
    grid-template-columns: minmax(0, 1fr);
    gap: 0.55rem;
    margin-top: 2.25rem;
    padding: 0.6rem;
    border: 1px solid rgba(148, 163, 184, 0.15);
    border-radius: 1.35rem;
    background:
      linear-gradient(118deg, rgba(12, 21, 38, 0.88), rgba(7, 12, 26, 0.91));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 24px 70px rgba(0, 0, 0, 0.34),
      0 0 0 1px rgba(34, 211, 238, 0.025);
    -webkit-backdrop-filter: blur(22px) saturate(145%);
    backdrop-filter: blur(22px) saturate(145%);
  }

  .discovery-dock::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    padding: 1px;
    border-radius: inherit;
    background: linear-gradient(105deg, transparent 3%, rgba(103, 232, 249, 0.36), transparent 45%, rgba(167, 139, 250, 0.3), transparent 92%);
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0.55;
    pointer-events: none;
  }

  .discovery-search {
    width: 100%;
    height: 3.5rem;
    border-radius: 0.9rem;
    background: rgba(3, 8, 20, 0.62);
  }

  .discovery-search .search-shell__input {
    padding-left: 2.8rem;
    font-size: 0.9rem;
  }

  .discovery-select,
  .discovery-toggle {
    position: relative;
    display: flex;
    min-width: 0;
    min-height: 3.5rem;
    align-items: center;
    gap: 0.55rem;
    border: 1px solid rgba(148, 163, 184, 0.105);
    border-radius: 0.9rem;
    background: rgba(255, 255, 255, 0.025);
    color: rgba(203, 213, 225, 0.88);
    text-align: left;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.035);
    transition:
      border-color 180ms ease,
      background-color 180ms ease,
      color 180ms ease,
      transform 180ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 180ms ease;
  }

  .discovery-select {
    padding: 0 0.72rem;
  }

  .discovery-control__icon {
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    color: rgba(125, 211, 252, 0.68);
  }

  .discovery-control__copy small,
  .discovery-toggle small {
    display: block;
    margin-bottom: 0.08rem;
    color: rgba(100, 116, 139, 0.82);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
  }

  .discovery-select select {
    min-width: 0;
    flex: 1;
    appearance: none;
    border: 0;
    outline: 0;
    background: transparent;
    color: rgba(241, 245, 249, 0.92);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 650;
    cursor: pointer;
  }

  .discovery-select select option {
    background: #0b1220;
    color: #e2e8f0;
  }

  .discovery-select__chevron {
    flex: 0 0 auto;
    color: rgba(148, 163, 184, 0.62);
    pointer-events: none;
  }

  .discovery-toggle {
    justify-content: flex-start;
    padding: 0 0.85rem;
    font-size: 0.78rem;
    font-weight: 650;
    cursor: pointer;
  }

  .discovery-toggle__signal {
    width: 0.48rem;
    height: 0.48rem;
    flex: 0 0 auto;
    border-radius: 50%;
    background: rgba(100, 116, 139, 0.85);
    box-shadow: 0 0 0 3px rgba(100, 116, 139, 0.08);
    transition:
      background-color 180ms ease,
      box-shadow 180ms ease;
  }

  .discovery-select:hover,
  .discovery-select:focus-within,
  .discovery-toggle:hover {
    border-color: rgba(125, 211, 252, 0.24);
    background: rgba(56, 189, 248, 0.055);
    color: #f8fafc;
  }

  .discovery-select:focus-within,
  .discovery-toggle:focus-visible {
    outline: 2px solid rgba(103, 232, 249, 0.72);
    outline-offset: 2px;
  }

  .discovery-toggle:active {
    transform: scale(0.98);
  }

  .discovery-toggle[aria-pressed='true'] {
    border-color: rgba(52, 211, 153, 0.28);
    background: rgba(16, 185, 129, 0.085);
    color: #a7f3d0;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 8px 24px rgba(16, 185, 129, 0.07);
  }

  .discovery-toggle[aria-pressed='true'] .discovery-toggle__signal {
    background: #34d399;
    box-shadow:
      0 0 0 3px rgba(52, 211, 153, 0.1),
      0 0 12px rgba(52, 211, 153, 0.7);
  }

  .discovery-toggle--saved > svg {
    flex: 0 0 auto;
    color: rgba(251, 113, 133, 0.8);
  }

  .discovery-toggle--saved[aria-pressed='true'] {
    border-color: rgba(251, 113, 133, 0.3);
    background: rgba(244, 63, 94, 0.085);
    color: #fecdd3;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.05),
      0 8px 24px rgba(244, 63, 94, 0.07);
  }

  .discovery-toggle--saved[aria-pressed='true'] > svg {
    fill: currentColor;
    color: #fb7185;
  }

  .discovery-meta {
    display: flex;
    width: 100%;
    max-width: 76rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.8rem;
    padding: 0 0.35rem;
    color: rgba(100, 116, 139, 0.92);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    text-align: left;
  }

  .discovery-meta strong {
    color: rgba(165, 243, 252, 0.9);
  }

  .discovery-reset {
    flex: 0 0 auto;
    border-radius: 999px;
    color: rgba(165, 180, 252, 0.88);
    font-weight: 700;
    cursor: pointer;
  }

  .discovery-reset:hover {
    color: #e0e7ff;
  }

  .discovery-reset:focus-visible {
    outline: 2px solid rgba(165, 180, 252, 0.75);
    outline-offset: 3px;
  }

  @media (min-width: 40rem) {
    .discovery-dock {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .discovery-search {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    .discovery-dock {
      grid-template-columns:
        minmax(18rem, 1.7fr)
        minmax(10.5rem, 0.84fr)
        minmax(9.5rem, 0.72fr)
        minmax(9.5rem, 0.74fr)
        minmax(7.5rem, 0.56fr);
    }

    .discovery-search {
      grid-column: auto;
    }
  }

  @media (max-width: 39.999rem) {
    .discovery-dock {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin-top: 1.65rem;
      padding: 0.5rem;
      border-radius: 1.15rem;
    }

    .discovery-search {
      grid-column: 1 / -1;
    }

    .discovery-select,
    .discovery-toggle {
      min-height: 3.25rem;
    }

    .discovery-control__copy {
      display: none;
    }

    .discovery-select select,
    .discovery-toggle {
      font-size: 0.73rem;
    }

    .discovery-toggle {
      padding-inline: 0.7rem;
    }

    .discovery-meta {
      font-size: 0.68rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-nav {
      transition-duration: 1ms;
    }
  }
</style>

