---
import PortfolioCard from '../components/PortfolioCard.astro';
import LoginModal from '../components/LoginModal.astro';
import SubmitModal from '../components/SubmitModal.astro';
import CustomCursor from '../components/CustomCursor.astro';
import portfoliosData from '../data/portfolios.json';
import VariableProximityWrapper from '../components/VariableProximityWrapper.jsx';
import Shuffle from '../components/Shuffle.jsx';
import SpecularButton from '../components/SpecularButton.jsx';
import DotField from '../components/DotField.jsx';
import '../styles/global.css';
import { sanitizePortfolio } from '../lib/utils.js';

const portfolios = portfoliosData
  .map((portfolio, index) => sanitizePortfolio({ ...portfolio, baseLikes: 0 }, index))
  .filter((portfolio): portfolio is NonNullable<typeof portfolio> => portfolio !== null);
const canonicalUrl = new URL(import.meta.env.BASE_URL, Astro.site);
---

<html lang="en">
  <head>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;700;900&family=Space+Grotesk:wght@400;700;900&display=swap" rel="stylesheet">
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Developer Portfolios Showcase</title>
    <meta name="description" content="A curated directory of developer portfolios inspired by Emma Bostian's repository." />
    <link rel="canonical" href={canonicalUrl} />
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content="Developer Portfolios Showcase" />
    <meta property="og:description" content="A curated directory of developer portfolios inspired by Emma Bostian's repository." />
    <meta property="og:image" content="https://images.unsplash.com/photo-1517694712202-14dd9538aa97?q=80&w=1200&auto=format&fit=crop" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalUrl} />
    <meta property="twitter:title" content="Developer Portfolios Showcase" />
    <meta property="twitter:description" content="A curated directory of developer portfolios inspired by Emma Bostian's repository." />
    <meta property="twitter:image" content="https://images.unsplash.com/photo-1517694712202-14dd9538aa97?q=80&w=1200&auto=format&fit=crop" />

    <!-- Google Analytics -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-N4PMFMQQ6Q"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){window.dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-N4PMFMQQ6Q');
    </script>
    <!-- U1 fix: removed `.portfolio-wrapper { content-visibility: auto }`.
         Its implicit paint containment clipped the hover summary tooltip (which is
         drawn above the card). Off-screen cards are already virtualized in JS by
         toggling the `hidden` class, so the perf intent is preserved. -->
  </head>
  <body class="bg-[#070b18] text-gray-200 min-h-screen font-sans antialiased selection:bg-rose-500/30">
    <div class="site-background" aria-hidden="true">
      <div class="site-background__ambient"></div>
      <DotField
        client:load
        className="site-background__dots"
        dotRadius={2.1}
        dotSpacing={18}
        cursorRadius={230}
        bulgeStrength={26}
        glowRadius={180}
        bulgeOnly={true}
        sparkle={false}
        waveAmplitude={0}
        gradientFrom="rgba(103, 232, 249, 0.43)"
        gradientTo="rgba(167, 139, 250, 0.35)"
        glowColor="rgba(56, 189, 248, 0.16)"
      />
      <div class="site-background__veil"></div>
    </div>
    <a href="#portfolioMain" class="skip-link">Skip to portfolios</a>
    <style>
      .animate-hero-text {
        opacity: 0;
        animation: heroReveal 0.8s cubic-bezier(0.2, 0, 0, 1) forwards;
      }

      @keyframes heroReveal {
        0% {
          opacity: 0;
          transform: translateY(24px);
        }
        100% {
          opacity: 1;
          transform: translateY(0);
        }
      }

      .text-metallic {
        background: linear-gradient(to bottom right, #ffffff 30%, #737373 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
      }
      @keyframes heartBurst {
        0% { transform: scale(1); }
        25% { transform: scale(1.5) rotate(-10deg); filter: brightness(1.5) drop-shadow(0 0 8px rgba(244,63,94,0.6)); }
        50% { transform: scale(0.85) rotate(10deg); }
        75% { transform: scale(1.15) rotate(-5deg); filter: brightness(1.2); }
        100% { transform: scale(1) rotate(0deg); }
      }

      @keyframes heartUnlike {
        0% { transform: scale(1.2); filter: brightness(1.5); }
        40% { transform: scale(0.7) rotate(15deg); opacity: 0.6; }
        70% { transform: scale(1.1) rotate(-5deg); opacity: 0.9; }
        100% { transform: scale(1) rotate(0deg); opacity: 1; }
      }

      .heart-animated {
        animation: heartBurst 0.34s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
      }

      .heart-unlike-animated {
        animation: heartUnlike 0.26s cubic-bezier(0.16, 1, 0.3, 1) forwards !important;
      }

      /* BUG-2 fix: each card wrapper creates its own stacking context, so a card's
         summary popup could render *under* the card sitting in the row above it.
         Lift the hovered wrapper above its neighbours so the popup (which overflows
         upward) always paints on top of everything else. */
      .portfolio-wrapper {
        position: relative;
        z-index: 1;
      }
      .portfolio-wrapper:hover,
      .portfolio-wrapper:focus-within {
        z-index: 50;
      }
    </style>

    <!-- Navigation Bar -->
    <nav id="topNavBar" class="sticky top-3 z-40 max-w-7xl mx-4 xl:mx-auto rounded-[24px] border border-white/[0.05]" style="transition: top 0.6s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.6s cubic-bezier(0.16, 1, 0.3, 1);">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-14">
          <button type="button" id="scrollToTopBtn" aria-label="Scroll to the top" class="flex items-center gap-2 cursor-pointer rounded-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-400">
            <span class="text-white font-extrabold tracking-tight text-lg flex items-center gap-1.5" style="font-family: 'Space Grotesk', sans-serif;">
              Portfolio
              <Shuffle 
                client:load 
                text="Universe" 
                className="text-cyan-400 pb-1"
                shuffleDirection="right"
                duration={0.35}
                stagger={0.03}
                shuffleTimes={1}
                triggerOnHover={true}
              />
            </span>
          </button>
          
          <div class="flex items-center gap-3 md:gap-4">
            <!-- Search Bar (Desktop) -->
            <div class="search-shell relative hidden md:block w-64 lg:w-72" data-search-shell>
              <label for="searchInputDesk" class="sr-only">Search developer portfolios</label>
              <span class="search-shell__icon" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7.5"/><path d="m20 20-3.8-3.8"/></svg>
              </span>
              <input type="search" id="searchInputDesk" placeholder="Search creators, roles, tech..." class="search-shell__input" autocomplete="off" autocapitalize="none" spellcheck="false" enterkeyhint="search" aria-controls="portfolioGrid" aria-keyshortcuts="/" />
              <span class="search-shell__shortcut" aria-hidden="true">/</span>
              <button type="button" class="search-shell__clear" data-search-clear aria-label="Clear search" aria-hidden="true" tabindex="-1" hidden>
                <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="m7 7 10 10M17 7 7 17"/></svg>
              </button>
            </div>

            <div class="hidden md:block">
              <SpecularButton
                client:load
                size="sm"
                radius={999}
                tint="#8b5cf6"
                tintOpacity={0.07}
                blur={10}
                textColor="#dbeafe"
                lineColor="#c4b5fd"
                baseColor="#475569"
                intensity={1.1}
                shineSize={12}
                shineFade={34}
                thickness={1}
                proximity={190}
                className="specular-button--nav-quiet"
                data-submit-trigger="true"
              >
                Submit
              </SpecularButton>
            </div>
            
            <!-- Auth Section -->
            <div id="authSection" class="flex items-center gap-3">
              <SpecularButton
                client:load
                id="loginBtn"
                size="sm"
                radius={999}
                tint="#2563eb"
                tintOpacity={0.18}
                blur={12}
                textColor="#ffffff"
                lineColor="#e0f2fe"
                baseColor="#2563eb"
                intensity={1.25}
                shineSize={13}
                shineFade={36}
                thickness={1.15}
                proximity={210}
                className="specular-button--nav-primary"
                data-login-trigger="true"
              >
                Login
              </SpecularButton>
              
              <!-- Logged In User View (Hidden by default) -->
              <div id="userProfile" class="hidden items-center gap-2 group">
                <img id="userAvatar" src="" alt="Avatar" referrerpolicy="no-referrer" class="w-8 h-8 rounded-full border border-gray-700 group-hover:border-blue-500 transition-colors" />
                <span id="userName" class="text-sm font-medium text-gray-200 hidden md:block"></span>
                <button type="button" id="logoutBtn" class="text-xs text-gray-400 hover:text-red-400 ml-2 transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-red-400 rounded">Logout</button>
              </div>
            </div>
          </div>
        </div>
        
        <!-- Mobile actions: search + Submit (md:hidden) -->
        <div class="md:hidden pb-3 flex items-center gap-2">
          <div class="search-shell search-shell--mobile relative flex-1 min-w-0" data-search-shell>
            <label for="searchInputMob" class="sr-only">Search developer portfolios</label>
            <span class="search-shell__icon" aria-hidden="true">
              <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="7.5"/><path d="m20 20-3.8-3.8"/></svg>
            </span>
            <input type="search" id="searchInputMob" placeholder="Search creators..." class="search-shell__input" autocomplete="off" autocapitalize="none" spellcheck="false" enterkeyhint="search" aria-controls="portfolioGrid" />
            <button type="button" class="search-shell__clear" data-search-clear aria-label="Clear search" aria-hidden="true" tabindex="-1" hidden>
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><path d="m7 7 10 10M17 7 7 17"/></svg>
            </button>
          </div>
          <SpecularButton
            client:load
            size="sm"
            radius={999}
            tint="#8b5cf6"
            tintOpacity={0.09}
            blur={10}
            textColor="#ffffff"
            lineColor="#bae6fd"
            baseColor="#475569"
            intensity={1.1}
            shineSize={12}
            shineFade={34}
            thickness={1}
            proximity={170}
            className="specular-button--mobile-submit"
            data-submit-trigger="true"
            aria-label="Submit a portfolio"
          >
            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M12 5v14"/></svg>
            Submit
          </SpecularButton>
        </div>
      </div>
    </nav>

    <header class="pt-10 pb-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto text-center relative z-10 flex flex-col items-center justify-center">
      
      <!-- Linear/Vercel Style Sharp Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-white/10 bg-transparent text-[11px] font-semibold text-white/70 uppercase tracking-widest mb-6 animate-hero-text" style="animation-delay: 0.1s; box-shadow: 0 0 20px rgba(255,255,255,0.02);">
        <span class="w-1.5 h-1.5 rounded-full bg-sky-400 shadow-[0_0_10px_rgba(56,189,248,0.8)] animate-pulse"></span>
        Regularly Updated Showcase
      </div>
      
      <!-- Monochrome High-Tracking Brutalist Title -->
      <h1 class="text-5xl sm:text-6xl md:text-[5.5rem] font-bold mb-4 leading-[0.95] tracking-tighter flex flex-col items-center justify-center relative z-10 w-full uppercase" style="font-family: 'Space Grotesk', sans-serif;">
        <span class="text-white animate-hero-text drop-shadow-xl" style="animation-delay: 0.2s; letter-spacing: -0.04em;">The Universe</span>
        <span class="text-metallic animate-hero-text" style="animation-delay: 0.3s; letter-spacing: -0.04em;">of Creators</span>
      </h1>
      
      <!-- Minimalist Subtitle -->
      <div class="mt-5 text-[1rem] md:text-[1.1rem] text-gray-400 max-w-2xl mx-auto leading-relaxed font-normal animate-hero-text text-center" style="font-family: 'Outfit', sans-serif; animation-delay: 0.4s;">
        <VariableProximityWrapper 
          client:visible 
          count={portfolios.length} 
        />
      </div>

      <!-- Glassmorphic Filters Container -->
      <div class="filter-rail-shell mt-8 w-full md:w-max max-w-full mx-auto relative z-20 shadow-2xl rounded-[24px]">
        
          <div class="relative flex items-center justify-start md:justify-center overflow-x-auto overflow-y-hidden hide-scrollbar gap-2 w-full p-1.5" style="-webkit-overflow-scrolling: touch;" id="filterContainer" role="group" aria-label="Filter portfolios">
        
        <!-- Smooth Fluid Indicator -->
        <div id="activeIndicator" class="absolute top-0 left-0 z-0 pointer-events-none" style="width: 0px; height: 0px; transform: translate3d(0px, 0px, 0);">
          
        </div>

        <button type="button" class="filter-btn active group relative z-10 flex items-center gap-2 px-5 py-2.5 rounded-2xl text-[14px] font-medium transition-all duration-300 tracking-wide" data-filter="all" aria-pressed="true">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70 group-hover:opacity-100 transition-opacity"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg>
          All
        </button>
        <button type="button" class="filter-btn group relative z-10 flex items-center gap-2 px-5 py-2.5 rounded-2xl text-[14px] font-medium text-purple-400 hover:text-purple-300 hover:bg-purple-500/10 transition-all duration-300 tracking-wide" data-filter="most_viewed" aria-pressed="false">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 transition-transform"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"/></svg>
          Trending
        </button>
        <button type="button" class="filter-btn group relative z-10 flex items-center gap-2 px-5 py-2.5 rounded-2xl text-[14px] font-medium text-gray-400 hover:text-white hover:bg-white/[0.05] transition-all duration-300 tracking-wide" data-filter="frontend" aria-pressed="false">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70 group-hover:opacity-100 transition-opacity"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
          Frontend
        </button>
        <button type="button" class="filter-btn group relative z-10 flex items-center gap-2 px-5 py-2.5 rounded-2xl text-[14px] font-medium text-gray-400 hover:text-white hover:bg-white/[0.05] transition-all duration-300 tracking-wide" data-filter="backend" aria-pressed="false">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70 group-hover:opacity-100 transition-opacity"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/></svg>
          Backend
        </button>
        <button type="button" class="filter-btn group relative z-10 flex items-center gap-2 px-5 py-2.5 rounded-2xl text-[14px] font-medium text-gray-400 hover:text-white hover:bg-white/[0.05] transition-all duration-300 tracking-wide" data-filter="fullstack" aria-pressed="false">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70 group-hover:opacity-100 transition-opacity"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          Full Stack
        </button>
        <button type="button" class="filter-btn group relative z-10 flex items-center gap-2 px-5 py-2.5 rounded-2xl text-[14px] font-medium text-gray-400 hover:text-white hover:bg-white/[0.05] transition-all duration-300 tracking-wide" data-filter="designer" aria-pressed="false">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-70 group-hover:opacity-100 transition-opacity"><path d="m12 19 7-7 3 3-7 7-3-3z"/><path d="m18 13-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"/><path d="m2 2 7.586 7.586"/><circle cx="11" cy="11" r="2"/></svg>
          Design
        </button>
        
        <div class="w-[2px] h-6 bg-white/[0.08] rounded-full self-center mx-2 hidden sm:block relative z-10"></div>

        <button type="button" class="filter-btn group relative z-10 flex items-center gap-2 px-5 py-2.5 rounded-2xl text-[14px] font-medium text-emerald-400 hover:text-emerald-300 hover:bg-emerald-500/10 transition-all duration-300 tracking-wide" data-filter="hire" aria-pressed="false">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.8)] group-hover:animate-pulse"></span>
          Hire Me
        </button>
        <button type="button" class="filter-btn group relative z-10 flex items-center gap-2 px-5 py-2.5 rounded-2xl text-[14px] font-medium text-rose-400 hover:text-rose-300 hover:bg-rose-500/10 transition-all duration-300 tracking-wide" data-filter="likes" aria-pressed="false">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:scale-110 transition-transform"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
          My Likes
        </button>
          </div>
        
      </div>
    </header>

    <main id="portfolioMain" class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-24 z-10" tabindex="-1">
      <p id="resultStatus" class="sr-only" role="status" aria-live="polite" aria-atomic="true">{portfolios.length} portfolios available.</p>
      <div id="portfolioGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6 md:gap-8 items-start" aria-busy="false">
        {portfolios.slice(0, 40).map((portfolio, index) => (
          <div 
            class="portfolio-wrapper" 
            data-index={index}
            data-name={portfolio.name.toLowerCase()}
            data-url={portfolio.url}
            data-role={portfolio.role?.toLowerCase() || ''}
            data-tech={Array.isArray(portfolio.tech_stack) ? portfolio.tech_stack.join(',').toLowerCase() : ''}
            data-hire={portfolio.available_for_hire ? 'true' : 'false'}
          >
            <PortfolioCard 
              name={portfolio.name} 
              url={portfolio.url} 
              screenshot={portfolio.screenshot} 
              summary={portfolio.summary}
              role={portfolio.role}
              tech_stack={portfolio.tech_stack}
              available_for_hire={portfolio.available_for_hire}
              base_likes={portfolio.baseLikes}
              views={portfolio.views || 0}
            />
          </div>
        ))}
      </div>

      <template id="portfolioCardTemplate">
        <div class="portfolio-wrapper">
          <PortfolioCard
            name="Portfolio"
            url="https://example.com"
            screenshot="https://images.unsplash.com/photo-1517694712202-14dd9538aa97?q=80&w=600&auto=format&fit=crop"
            summary="Portfolio summary"
            role="Developer"
            tech_stack={['Stack one', 'Stack two', 'Stack three', 'Stack four']}
            available_for_hire={true}
            base_likes={0}
            views={0}
          />
        </div>
      </template>
      
      <!-- Empty State -->
      <div id="emptyState" class="hidden text-center py-20">
        <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-gray-800/50 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-gray-500"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        </div>
        <h3 class="text-xl font-bold text-white mb-2">No portfolios found</h3>
        <p class="text-gray-400 text-lg">Try adjusting your search or filters.</p>
        <button type="button" id="clearFiltersBtn" class="mt-4 text-blue-400 hover:text-blue-300 font-medium focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 rounded">Clear all filters</button>
      </div>

      <!-- Infinite Scroll Trigger / Loader -->
      <button type="button" id="loadMoreContainer" aria-label="Load more portfolios" class="mt-16 mb-8 w-full justify-center items-center focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-400 rounded-full" style="display: none;">
        <span class="flex items-center gap-3 px-6 py-3 bg-gray-900/50 backdrop-blur-md rounded-full border border-gray-800">
          <svg class="animate-spin -ml-1 mr-2 h-5 w-5 text-blue-500" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
