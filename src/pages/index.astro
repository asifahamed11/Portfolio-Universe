<style>
  .search-shell {
    isolation: isolate;
    height: 2.5rem;
    border-radius: 999px;
    background:
      linear-gradient(135deg, rgba(10, 18, 36, 0.86), rgba(5, 9, 22, 0.8));
    -webkit-backdrop-filter: blur(14px) saturate(135%);
    backdrop-filter: blur(14px) saturate(135%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 8px 26px rgba(0, 0, 0, 0.2);
    transition:
      transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 220ms ease,
      background-color 220ms ease;
  }

  .search-shell::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    padding: 1px;
    border-radius: inherit;
    background: linear-gradient(
      110deg,
      rgba(100, 116, 139, 0.45),
      rgba(103, 232, 249, 0.7),
      rgba(129, 140, 248, 0.62),
      rgba(100, 116, 139, 0.4)
    );
    background-size: 220% 100%;
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    mask-composite: exclude;
    opacity: 0.5;
    pointer-events: none;
    transition: opacity 200ms ease;
  }

  .search-shell::after {
    content: '';
    position: absolute;
    inset: -5px;
    z-index: -1;
    border-radius: inherit;
    background: linear-gradient(90deg, rgba(34, 211, 238, 0.15), rgba(139, 92, 246, 0.15));
    filter: blur(12px);
    opacity: 0;
    pointer-events: none;
    transition: opacity 220ms ease;
  }

  .search-shell:focus-within {
    transform: translateY(-1px);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.11),
      0 10px 30px rgba(2, 132, 199, 0.12),
      0 0 0 3px rgba(34, 211, 238, 0.07);
  }

  .search-shell:focus-within::before {
    opacity: 1;
    animation: searchRimSweep 2.8s linear infinite;
  }

  .search-shell:focus-within::after {
    opacity: 1;
  }

  .search-shell__input {
    position: relative;
    z-index: 1;
    width: 100%;
    height: 100%;
    border: 0;
    border-radius: inherit;
    outline: none;
    background: transparent;
    padding: 0 3rem 0 2.65rem;
    color: #e5f2ff;
    caret-color: #67e8f9;
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.005em;
  }

  .search-shell__input::placeholder {
    color: rgba(148, 163, 184, 0.72);
    transition: color 180ms ease;
  }

  .search-shell:focus-within .search-shell__input::placeholder {
    color: rgba(186, 230, 253, 0.6);
  }

  .search-shell__input::-webkit-search-cancel-button {
    display: none;
  }

  .search-shell__icon {
    position: absolute;
    top: 50%;
    left: 0.85rem;
    z-index: 2;
    display: grid;
    place-items: center;
    color: rgba(148, 163, 184, 0.78);
    pointer-events: none;
    transform: translateY(-50%);
    transform-origin: center;
    transition:
      color 180ms ease,
      transform 220ms cubic-bezier(0.16, 1, 0.3, 1),
      filter 180ms ease;
  }

  .search-shell:focus-within .search-shell__icon {
    color: #67e8f9;
    filter: drop-shadow(0 0 7px rgba(34, 211, 238, 0.55));
    transform: translateY(-50%) scale(1.08) rotate(-5deg);
  }

  .search-shell[data-searching="true"] .search-shell__icon {
    animation: searchIconPulse 700ms ease-in-out infinite alternate;
  }

  .search-shell__shortcut {
    position: absolute;
    top: 50%;
    right: 0.75rem;
    z-index: 2;
    min-width: 1.35rem;
    padding: 0.1rem 0.35rem;
    border: 1px solid rgba(148, 163, 184, 0.16);
    border-radius: 0.4rem;
    background: rgba(255, 255, 255, 0.035);
    color: rgba(148, 163, 184, 0.68);
    font-size: 0.68rem;
    line-height: 1.1rem;
    text-align: center;
    pointer-events: none;
    transform: translateY(-50%);
    transition:
      opacity 150ms ease,
      transform 180ms ease;
  }

  .search-shell[data-has-value="true"] .search-shell__shortcut,
  .search-shell:focus-within .search-shell__shortcut {
    opacity: 0;
    transform: translateY(-50%) scale(0.8);
  }

  .search-shell__clear {
    position: absolute;
    top: 50%;
    right: 0.35rem;
    z-index: 3;
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid rgba(148, 163, 184, 0.13);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.045);
    color: rgba(203, 213, 225, 0.8);
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      color 160ms ease,
      background-color 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .search-shell__clear[hidden] {
    display: none;
  }

  .search-shell__clear:hover {
    border-color: rgba(103, 232, 249, 0.32);
    background: rgba(34, 211, 238, 0.1);
    color: #cffafe;
    transform: translateY(-50%) scale(1.05);
  }

  .search-shell__clear:focus-visible {
    outline: 2px solid rgba(103, 232, 249, 0.85);
    outline-offset: 2px;
  }

  .search-shell--mobile {
    height: 2.75rem;
  }

  .search-shell--mobile .search-shell__input {
    font-size: 1rem;
  }

  @keyframes searchRimSweep {
    to {
      background-position: -220% 0;
    }
  }

  @keyframes searchIconPulse {
    to {
      color: #c4b5fd;
      filter: drop-shadow(0 0 9px rgba(139, 92, 246, 0.6));
    }
  }

  #topNavBar::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      border-radius: 24px;
      background-color: rgba(255, 255, 255, 0.01);
      pointer-events: none;
  }
  
  #topNavBar::after {
      content: '';
      position: absolute;
      z-index: -2;
      inset: 0;
      border-radius: 24px;
      -webkit-backdrop-filter: blur(8px) saturate(120%);
              backdrop-filter: blur(8px) saturate(120%);
      overflow: hidden;
      isolation: isolate;
      pointer-events: none;
  }


  .filter-rail-shell {
    isolation: isolate;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.075);
    background:
      linear-gradient(115deg, rgba(15, 23, 42, 0.66), rgba(3, 7, 18, 0.76));
    -webkit-backdrop-filter: blur(18px) saturate(135%);
    backdrop-filter: blur(18px) saturate(135%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.08),
      inset 0 -1px 0 rgba(15, 23, 42, 0.75),
      0 18px 46px rgba(0, 0, 0, 0.32);
  }

  .filter-rail-shell::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 20;
    border-radius: inherit;
    box-shadow:
      inset 1px 1px 0 rgba(255, 255, 255, 0.1),
      inset -1px -1px 0 rgba(99, 102, 241, 0.06);
    pointer-events: none;
  }

  #activeIndicator {
    border: 1px solid transparent;
    border-radius: 16px;
    opacity: 0;
    background:
      linear-gradient(125deg, rgba(14, 23, 43, 0.9), rgba(18, 13, 38, 0.78)) padding-box,
      conic-gradient(
        from 220deg,
        rgba(71, 85, 105, 0.52),
        rgba(125, 211, 252, 0.92),
        rgba(196, 181, 253, 0.6),
        rgba(71, 85, 105, 0.45),
        rgba(96, 165, 250, 0.72),
        rgba(71, 85, 105, 0.52)
      ) border-box;
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.12),
      0 7px 20px rgba(14, 165, 233, 0.08);
    -webkit-backdrop-filter: blur(10px) saturate(135%);
    backdrop-filter: blur(10px) saturate(135%);
    will-change: transform, width, height;
  }

  #activeIndicator.is-ready {
    opacity: 1;
    transition:
      transform 460ms cubic-bezier(0.34, 1.56, 0.64, 1),
      width 460ms cubic-bezier(0.34, 1.56, 0.64, 1),
      height 460ms cubic-bezier(0.34, 1.56, 0.64, 1),
      opacity 160ms ease;
  }

  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fadeInUp 0.5s ease-out forwards;
  }
  
  /* Active filter button styles */
  .filter-btn {
    flex-shrink: 0;
    white-space: nowrap;
  }
  .filter-btn.active {
